# RoboAdvisor Environment Variables Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# REQUIRED VARIABLES (Must be set)
# =============================================================================

# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=your_openai_api_key_here

# Backend Configuration (REQUIRED)
SECRET_KEY=your_secret_key_here

# =============================================================================
# OPTIONAL VARIABLES (Can be left empty)
# =============================================================================

# External Services (OPTIONAL)
TAVILY_API_KEY=your_tavily_api_key_here
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=financial-advisor-assistant

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Frontend URL (update with your domain/IP)
FRONTEND_URL=http://your-ec2-public-ip:3000

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://your-ec2-public-ip:3000,https://roboadvisor-mu.vercel.app,http://localhost:3000

# Frontend Environment Variables (for Next.js)
NEXT_PUBLIC_API_BASE_URL=http://your-ec2-public-ip:8000
NEXT_PUBLIC_CHATBOT_URL=http://chatbot:8001
NEXT_PUBLIC_CHATBOT_WS_URL=ws://your-ec2-public-ip:8001

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# QDRANT CONFIGURATION (Docker Compose handles these automatically)
# =============================================================================

# These are automatically set by Docker Compose - DO NOT CHANGE
# QDRANT_URL=http://qdrant:6333
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333
# BACKEND_API_URL=http://backend:8000

# =============================================================================
# ENVIRONMENT DETECTION (Automatically detected)
# =============================================================================

# These are automatically detected - DO NOT SET MANUALLY
# RENDER= (set by Render platform)
# AWS_EXECUTION_ENV= (set by AWS)
# EC2_INSTANCE_ID= (set by AWS EC2)
